rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isLandlord() {
      return signedIn() && roleOf(request.auth.uid) == 'landlord';
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function tenantOfExisting() {
      return signedIn() && resource.data.tenantId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['tenant', 'landlord'];
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /properties/{propertyId} {
      allow read: if ownsExisting();
      allow create: if isLandlord()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsExisting()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if ownsExisting();
    }

    match /units/{unitId} {
      allow read: if ownsExisting() || tenantOfExisting();
      allow create: if isLandlord()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsExisting()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if ownsExisting();
    }

    match /rentRecords/{recordId} {
      allow read: if ownsExisting() || tenantOfExisting();
      allow create: if isLandlord()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if tenantOfExisting()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid'])
        && request.resource.data.amountPaid > resource.data.amountPaid
        && request.resource.data.amountPaid <= resource.data.amountDue;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if ownsExisting() || tenantOfExisting();
      allow create: if signedIn()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.amount > 0
        && get(/databases/$(database)/documents/rentRecords/$(request.resource.data.rentRecordId)).data.tenantId == request.auth.uid;
      allow update, delete: if false;
    }

    match /maintenanceRequests/{requestId} {
      allow read: if ownsExisting() || tenantOfExisting();
      allow create: if signedIn()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == 'open'
        && get(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.tenantId == request.auth.uid;
      allow update: if ownsExisting()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'in_progress', 'resolved'];
      allow delete: if false;
    }
  }
}
